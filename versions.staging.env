# What staging runs: for each service, the branch it follows and the image tag
# (that branch's commit SHA, as pushed to ghcr.io/zimmerman-team/dx-<service>).
#
# When an app repo's CI pushes an image for a branch, the update-tag workflow
# writes the new tag into every environment that follows that branch, then
# deploys them. To follow another branch, run the switch-branch workflow, or
# change <SERVICE>_BRANCH and <SERVICE>_TAG here in a PR.
# `make repos` clones these branches.
#
# Until production moves to infra.dx, staging and test follow each app repo's
# chore/standardisation branch: develop and main don't have the Dockerfiles yet.

# The self-hosted runner this environment deploys on (deploy.yaml).
RUNNER=staging

CLIENT_BRANCH=chore/standardisation
CLIENT_TAG=1be04782752f363a36d23d97c16de3840e951f39

SERVER_BRANCH=chore/standardisation
SERVER_TAG=e3a5e84a005d99e15c9cf0f107c3edeac73e841b

BACKEND_BRANCH=chore/standardisation
BACKEND_TAG=5c519798e6d8d30d81d7caf5ca9de2c1336c8bc7

AI_API_BRANCH=chore/standardisation
AI_API_TAG=3f99abd69d33f5aa7151c7b3344f670824b69ebc

# Only runs with the cms profile.
CMS_BRANCH=chore/standardisation
CMS_TAG=24d2d037f2f8dfcf41aa5659c7848ed748f4bfb6
