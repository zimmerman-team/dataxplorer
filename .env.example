# Settings for one DX environment. Every variable DX reads is listed here with a
# dummy value.
#
# - Development: `make dev` copies this file to .env.development the first time.
#   The values below work for a local run; fill in real keys for the features you need.
# - Servers: the file lives outside the checkout, in /opt/dx/.env.<env>, owned by the
#   deploy user with chmod 600 (docs/MIGRATION.md). Never commit a real env file.
#
# Where a value differs per environment, the comment lists it as
#   dev | test | staging | production
# Wrap values that contain $ in single quotes, or compose will try to expand them.

# --------------------------------------------------------------------------- #
# Compose

# Optional profile: cms (runs CMS-DX and its Postgres). Empty runs without it.
COMPOSE_PROFILES=

# Host ports, bound to 127.0.0.1 only; the host's nginx proxies to them.
# Environments that share a server (test and staging) need different ones;
# these defaults already differ.
#   client:  8080 | 8202 | 8201 | 8200
#   server:  4200 | 4202 | 4201 | 4200
#   backend: 4004 | 4006 | 4005 | 4004
#   ai-api:  5000 | 5002 | 5001 | 5000
#   cms:     1337 | 1339 | 1338 | 1337
CLIENT_PORT=8080
SERVER_PORT=4200
BACKEND_PORT=4004
AI_API_PORT=5000
CMS_PORT=1337

# The backend's memory cap on servers (compose.prod.yaml). Environments that
# share a server split its memory, for example 4G each for test and staging.
BACKEND_MEMORY_LIMIT=8G

# Key files mounted into containers: backend/kaggle.json, backend/hdx_configuration.yaml
# and server/<google key>.json. Environments on one server can share the folder.
#   ./secrets | /opt/dx/secrets | /opt/dx/secrets | /opt/dx/secrets
SECRETS_DIR=./secrets

# --------------------------------------------------------------------------- #
# Environment type, read by the server and the client.  dev | test | staging | prod
ENV_TYPE=dev
VITE_ENV_TYPE=dev

# --------------------------------------------------------------------------- #
# MongoDB. The server and backend log in with MONGO_USERNAME / MONGO_PASSWORD,
# so they must match the INITDB values.
MONGO_INITDB_ROOT_USERNAME=admin_example
MONGO_INITDB_ROOT_PASSWORD=exampl3_123
MONGO_INITDB_DATABASE=the-data-explorer-db
MONGO_USERNAME=admin_example
MONGO_PASSWORD=exampl3_123
MONGO_AUTH_SOURCE=admin

# Redis: the password redis starts with, and the one the server uses.
REDIS_PASSWORD=redis_example

# --------------------------------------------------------------------------- #
# DX Client (public: these end up in the browser)

# The server's public URL.  http://localhost:4200 | https://server.test.<domain> | https://server.staging.<domain> | https://server.<domain>
VITE_API=http://localhost:4200
VITE_BASE_URL=
VITE_CMS_API='the CMS address'
VITE_CMS_TOKEN='your CMS token'
VITE_GOOGLE_API_CLIENT_ID='your id for the Google Drive integration'
VITE_GOOGLE_API_DEV_KEY='your key for the Google Drive integration'
VITE_AUTH0_DOMAIN='your auth0 tenant app domain'
VITE_AUTH0_CLIENT='your auth0 tenant app client id'
VITE_AUTH0_AUDIENCE='your auth0 tenant app audience'
VITE_HUBSPOT_PORTAL_ID='your hubspot portal id'
VITE_HUBSPOT_SUBSCRIBE_FORM_ID='your hubspot subscribe form id'
VITE_INTERCOM_APP_ID='your intercom app id'
VITE_ONEDRIVE_CLIENT_ID='your onedrive client id'
VITE_MAPBOX_TOKEN='your mapbox token'
VITE_LIVE_SESSION_ID='your livesession id'

# --------------------------------------------------------------------------- #
# How much the server and backend log to stdout: error, warn, info, debug.
LOG_LEVEL=info

# --------------------------------------------------------------------------- #
# DX Server
AUTH0_DOMAIN='your auth0 tenant app domain'
AUTH0_AUDIENCE='your auth0 tenant app audience'
AUTH0_TOKEN_URL='your auth0 token url'
AUTH0_MGMT_CLIENT='your auth0 management client id'
AUTH0_MGMT_SECRET='your auth0 management client secret'

PRICING_ACTIVE=false
STRIPE_API_KEY='your stripe api key'
STRIPE_PRODUCT_FREE_MONTHLY_PRICE_ID='your stripe free product monthly price id'
STRIPE_PRODUCT_FREE_ANNUALLY_PRICE_ID='your stripe free product annually price id'
STRIPE_PRODUCT_PRO_MONTHLY_PRICE_ID='your stripe pro product monthly price id'
STRIPE_PRODUCT_PRO_ANNUALLY_PRICE_ID='your stripe pro product annually price id'
STRIPE_PRODUCT_TEAM_MONTHLY_PRICE_ID='your stripe team product monthly price id'
STRIPE_PRODUCT_TEAM_ANNUALLY_PRICE_ID='your stripe team product annually price id'
STRIPE_PRODUCT_ENTERPRISE_MONTHLY_PRICE_ID='your stripe enterprise product monthly price id'
STRIPE_PRODUCT_ENTERPRISE_ANNUALLY_PRICE_ID='your stripe enterprise product annually price id'

# Media search
GOOGLE_API_KEY='Google Cloud API key with YouTube API access'
SHUTTERSTOCK_API_TOKEN='shutterstock api token'
UNSPLASH_ACCESS_KEY='unsplash access key'
VIMEO_ACCESS_TOKEN='vimeo access token'

INTERCOM_SECRET_KEY='from intercom'
INTERCOM_ACCESS_TOKEN='from intercom'

# Google Calendar. The key file goes in $SECRETS_DIR/server/, which the server
# sees as /app/secrets/. Leave GOOGLE_CALENDAR_KEY_FILE empty to turn it off.
GOOGLE_CALENDAR_ID=
GOOGLE_CALENDAR_SEARCH_QUERY=
GOOGLE_CALENDAR_SUBJECT=
GOOGLE_CALENDAR_KEY_FILE=

# --------------------------------------------------------------------------- #
# DX Backend
DW_AUTH_TOKEN='your token from https://data.world/settings/advanced'

# --------------------------------------------------------------------------- #
# AI API. Callers send AIAPI_API_KEY in the Authorization header.
AIAPI_API_KEY='any key the server sends with its requests'
AIAPI_OPENAI_API_KEY='your OpenAI API key'
FLASK_DEBUG=False

# --------------------------------------------------------------------------- #
# CMS (cms profile only)
CMS_DATABASE_NAME=strapi
CMS_DATABASE_USERNAME=strapi
CMS_DATABASE_PASSWORD=strapi_example
CMS_JWT_SECRET=tobemodified
CMS_ADMIN_JWT_SECRET=tobemodified
CMS_APP_KEYS='toBeModified1,toBeModified2'
CMS_API_TOKEN_SALT=tobemodified
CMS_TRANSFER_TOKEN_SALT=tobemodified
