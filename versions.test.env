# What the test environment runs: for each service, the branch it follows and
# the image tag (that branch's commit SHA, as pushed to ghcr.io/zimmerman-team/dx-<service>).
#
# Test is for trying feature branches: run the switch-branch workflow to point a
# service at any branch that has an image. From then on, every push to that
# branch deploys here.
#
# Until production moves to infra.dx, staging and test follow each app repo's
# chore/standardisation branch: develop and main don't have the Dockerfiles yet.

CLIENT_BRANCH=chore/standardisation
CLIENT_TAG=b9143f5d5bbc7c6fb79edb9b6d7daf6362757d00

SERVER_BRANCH=chore/standardisation
SERVER_TAG=9ed6070738276195a91a8386bf7bea7f2d39ca27

BACKEND_BRANCH=chore/standardisation
BACKEND_TAG=c91d3c8f9e1c83d405fe3265a374f06f2deac959

AI_API_BRANCH=chore/standardisation
AI_API_TAG=e95aba21daa14f82871b71b6016df1f3908b8aac

# Only runs with the cms profile.
CMS_BRANCH=chore/standardisation
CMS_TAG=a8a904819e1311ad9b6ad1bebf7993703314af94
