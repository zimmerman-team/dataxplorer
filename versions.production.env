# What production runs: the image tag of each service (the app repo's commit
# SHA, as pushed to ghcr.io/zimmerman-team/dx-<service>).
#
# Production follows no branch, so nothing changes it automatically. Change a
# tag in a pull request; merging the PR deploys production. To ship exactly what
# staging tested, copy staging's tag. To roll back, restore the previous tag.

# The self-hosted runner this environment deploys on (deploy.yaml).
RUNNER=prod

# Dx.client, main
CLIENT_TAG=953bcfad7880f10a605c0762071aa021e885b293
# Dx.server, main
SERVER_TAG=44a07633db2b516927cd0a35b959a912138abe38
# dx.backend, main
BACKEND_TAG=e6e1eae428adcb7f1f4d6d18506e4799a3961326
# general-ai-api, main
AI_API_TAG=417aa1b06a20c30d1a61870fdfb36a402b1ec964
# CMS-DX, main (only runs with the cms profile)
CMS_TAG=fb3c17a45be2ff6c85dba67c81501a9a2f529c85
